{
  "name": "arc-builder",
  "version": "1.0.0",
  "description": "Arc PayLink creates obligation-aware USDC payment requests with verifiable settlement, walletless claims, and controlled non-executable recovery on Arc.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run && hardhat test",
    "test:app": "vitest run",
    "agentops": "node --import tsx agentops/server.ts",
    "agentops:demo": "node --import tsx agentops/demo.ts",
    "agentops:demo:build": "node --import tsx agentops/build-demo.ts",
    "collections:watch": "node --import tsx agentops/collections-watch.ts",
    "collections:watch:once": "node --import tsx agentops/collections-watch.ts --once",
    "collections:demo:build": "node --import tsx agentops/build-collections-demo.ts",
    "collections:video:build": "node agentops/build-collections-video.mjs",
    "agentops:test": "vitest run agentops",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy:arc": "hardhat run scripts/deploy-escrow.cjs --network arcTestnet",
    "contracts:deploy:arc-mainnet": "hardhat run scripts/deploy-mainnet-escrow.cjs --network arcMainnet",
    "contracts:settle:arc-mainnet-pilot": "hardhat run scripts/send-mainnet-settlement.cjs --network arcMainnet",
    "contracts:create-mainnet-walletless-escrow": "hardhat run scripts/create-fund-mainnet-circle-escrow.cjs --network arcMainnet",
    "contracts:verify:arc-mainnet": "hardhat compile && node scripts/verify-mainnet-deployment.cjs",
    "contracts:create-test-escrow": "hardhat run scripts/create-test-escrow.cjs --network arcTestnet",
    "contracts:create-fund-circle-escrow": "hardhat run scripts/create-fund-circle-escrow.cjs --network arcTestnet",
    "contracts:fund-test-escrow": "node scripts/fund-test-escrow.cjs",
    "contracts:verify-test-escrow-funding": "node scripts/verify-test-escrow-funding.cjs",
    "contracts:claim-test-escrow": "hardhat run scripts/claim-test-escrow.cjs --network arcTestnet"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.15.0",
    "@circle-fin/app-kit": "^1.12.0",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@vercel/blob": "^2.8.0",
    "next": "^16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.55.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@circle-fin/cli": "1.1.4",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "chai": "^4.5.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "ethers": "^6.15.0",
    "hardhat": "^2.29.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@firebase/auth": {
      "undici": "6.28.1"
    },
    "@firebase/auth-compat": {
      "undici": "6.28.1"
    },
    "@firebase/firestore": {
      "undici": "6.28.1",
      "@grpc/grpc-js": "1.13.6"
    },
    "@firebase/functions": {
      "undici": "6.28.1"
    },
    "@firebase/storage": {
      "undici": "6.28.1"
    },
    "@coral-xyz/anchor": {
      "toml": "4.2.0"
    }
  }
}
