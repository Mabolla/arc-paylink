# Explicitly select testnet or mainnet. Mainnet deployments must set this to mainnet.
NEXT_PUBLIC_ARC_NETWORK=testnet
# Optional RPC override. The official RPC for the selected network is used by default.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
# Required for mainnet claim packages after the verified factory deployment.
NEXT_PUBLIC_ARC_PAYLINK_FACTORY_ADDRESS=

# Circle user-controlled wallet onboarding. Keep the API key server-side.
CIRCLE_API_KEY=
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Required only after Circle confirms/enables the Arc mainnet blockchain identifier.
CIRCLE_ARC_BLOCKCHAIN=

# Contract deployment only. Export this in your shell; never commit a funded key.
# ARC_TESTNET_PRIVATE_KEY=0x...
# ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# ARC_MAINNET_PRIVATE_KEY=0x...
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# CONFIRM_ARC_MAINNET_DEPLOY=ARC_PAYLINK_MAINNET
# SOURCE_COMMIT=<40-character git commit>
# ARC_PAYLINK_CLAIM_PUBLIC_KEY=<base64 DER public key>
# ARC_PAYLINK_TEST_AMOUNT_USDC=0.01
